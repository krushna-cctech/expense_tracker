# Copy to .env and fill in. Never commit the real .env (it is git-ignored).
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/expense_tracker
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated allowed client origins (PWA dev server, extension, etc.)
CORS_ORIGINS=http://localhost:5173
