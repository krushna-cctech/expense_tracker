{
  "name": "expense-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Expense Tracker — PWA + browser extension backed by a shared Node/Express/MongoDB API.",
  "workspaces": [
    "src/shared",
    "src/server",
    "src/pwa",
    "src/extension"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build -w @expense-tracker/shared",
    "dev:server": "npm run dev -w @expense-tracker/server",
    "dev:pwa": "npm run dev -w @expense-tracker/pwa",
    "dev:extension": "npm run dev -w @expense-tracker/extension",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json,md}\""
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
